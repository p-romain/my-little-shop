meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.com",
    "password": "password"
  }
}

script:post-response {
  const payload = res.getBody();

  if (payload?.token) {
    bru.setEnvVar("jwt", payload.token);
  }
}
